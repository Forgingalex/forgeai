APP_NAME=ForgeAI
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=change-this-secret-before-production

DATABASE_URL=postgresql+psycopg://forgeai:forgeai@localhost:5432/forgeai
DATABASE_URL_ASYNC=postgresql+asyncpg://forgeai:forgeai@localhost:5432/forgeai

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-1.5-pro
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

CHROMA_MODE=persistent
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=chroma_data
CHROMA_COLLECTION=forgeai_knowledge
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
HYBRID_SEMANTIC_WEIGHT=0.72

